# ==============================================================================
# ZeroChat AI — Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="ZeroChat AI"
APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# Supabase Configuration & PostgreSQL Database
# ------------------------------------------------------------------------------
# 1. Supabase Project URL and API Keys (from Supabase Dashboard -> Project Settings -> API):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# The service_role key is SECRET and used ONLY by the backend. NEVER expose it to Android or GitHub:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=zerochat-attachments

# 2. Database Connection String:
# For Local Development / Testing (Default Async SQLite):
DATABASE_URL=sqlite+aiosqlite:///./zerochat.db

# For Supabase PostgreSQL (from Supabase Dashboard -> Project Settings -> Database -> Connection string):
# - Direct / Session Pooler (Port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres
# - Transaction Pooler (Port 6543, recommended):
# DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your_db_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key: openssl rand -hex 32
SECRET_KEY=a97ee32f520194cf148d3f6c0c3fc38abada3af9c6c9d5d7a3fcfbe85770ef16
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# Verification & Rate Limiting Policies
# ------------------------------------------------------------------------------
VERIFICATION_CODE_EXPIRE_MINUTES=5
MAX_VERIFICATION_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
MAX_CODE_REQUESTS_PER_HOUR=5
MAX_LOGIN_ATTEMPTS_PER_15MIN=5

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Choose Option A or Option B)
# ------------------------------------------------------------------------------
# OPTION A: Resend HTTPS REST API (RECOMMENDED for Render / Cloud Hosting)
# Render and many cloud platforms block outbound SMTP ports (25/465/587).
# Resend uses standard HTTPS (port 443) which works seamlessly on all clouds.
# 1. Sign up free at https://resend.com
# 2. Get API key from https://resend.com/api-keys
# 3. Enter key below (e.g. re_abc123...):
RESEND_API_KEY=your_resend_api_key_here
# Optional: Set your custom verified domain sender (defaults to 'onboarding@resend.dev'):
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# OPTION B: SMTP Configuration (Gmail SMTP)
# IMPORTANT SECURITY NOTICE:
# - NEVER store users' Gmail passwords.
# - NEVER store personal Google account master passwords here.
# - Use a 16-character Google App Password:
#   1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Select App: "Other (ZeroChat AI)" -> Generate
#   4. Paste the 16-character password below without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="ZeroChat AI Security"
SMTP_USE_TLS=True
SMTP_ENABLED=False

# ------------------------------------------------------------------------------
# Founder / Super Admin Provisioning
# ------------------------------------------------------------------------------
# The founder account is automatically provisioned on startup if enabled,
# or can be provisioned via CLI: `python -m app.cli create-founder`
FOUNDER_EMAIL=founder@zerochat.ai
FOUNDER_PASSWORD=Founder@ZeroChat2026!
FOUNDER_USERNAME=ZeroFounder
FOUNDER_AUTO_PROVISION=True
